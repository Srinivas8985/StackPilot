# Example Terraform Variables for Dedicated StackPilot Node

aws_region        = "us-east-1"
instance_type     = "t3.micro"
ami_os            = "ubuntu" # "ubuntu" or "amazon-linux"
deployment_id     = "demo-deploy-001"
infrastructure_id = "infra-doc-001"
environment       = "production"
app_port          = 3000
ssh_allowed_cidr  = "203.0.113.50/32" # Replace with trusted IP or CIDR
app_allowed_cidr  = "0.0.0.0/0"
ssh_key_name      = "stackpilot-dedicated-key"
root_volume_size  = 20

resource_tags = {
  Client      = "Enterprise"
  CostCenter  = "Engineering"
}

